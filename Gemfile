source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# GitHub Pages' bundled Jekyll doesn't need these gems added separately,
# but local `jekyll serve` on Ruby 3.4+/4.x does, since they were removed
# from Ruby's default gems.
gem "webrick"
gem "csv"
gem "base64"
gem "logger"
gem "bigdecimal"
gem "benchmark"
gem "mutex_m"
gem "drb"
gem "ostruct"
